{
	"name": "pipeline-graph-editor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:all": "npm run check && npm run test && npm run test:e2e",
		"bench": "npm run bench:interact && npm run bench:gestures && npm run bench:stream && npm run bench:table && npm run bench:a11y && npm run bench:draw",
		"bench:interact": "npx esbuild tools/bench-interact.ts --bundle --format=esm --platform=node --alias:'$lib'=./src/lib --banner:js='globalThis.$state=(v)=>v;' --outfile=node_modules/.bench/bench-interact.mjs --log-level=warning && node node_modules/.bench/bench-interact.mjs",
		"bench:gestures": "npx esbuild tools/bench-gestures.ts --bundle --format=esm --platform=node --alias:'$lib'=./src/lib --banner:js='globalThis.$state=(v)=>v;' --outfile=node_modules/.bench/bench-gestures.mjs --log-level=warning && node node_modules/.bench/bench-gestures.mjs",
		"bench:stream": "npx esbuild tools/bench-stream.ts --bundle --format=esm --platform=node --alias:'$lib'=./src/lib --banner:js='globalThis.$state=(v)=>v;' --outfile=node_modules/.bench/bench-stream.mjs --log-level=warning && node node_modules/.bench/bench-stream.mjs",
		"bench:table": "npx esbuild tools/bench-table.ts --bundle --format=esm --platform=node --alias:'$lib'=./src/lib --banner:js='globalThis.$state=(v)=>v;' --outfile=node_modules/.bench/bench-table.mjs --log-level=warning && node node_modules/.bench/bench-table.mjs",
		"bench:a11y": "npx esbuild tools/bench-a11y.ts --bundle --format=esm --platform=node --alias:'$lib'=./src/lib --banner:js='globalThis.$state=(v)=>v;' --outfile=node_modules/.bench/bench-a11y.mjs --log-level=warning && node node_modules/.bench/bench-a11y.mjs",
		"bench:draw": "npx esbuild tools/bench-draw.ts --bundle --format=esm --platform=node --alias:'$lib'=./src/lib --banner:js='globalThis.$state=(v)=>v;' --outfile=node_modules/.bench/bench-draw.mjs --log-level=warning && node node_modules/.bench/bench-draw.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-quadtree": "^3.0.6",
		"@vitest/browser": "^5.0.1",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"d3-quadtree": "^3.0.1",
		"elkjs": "^0.12.0"
	}
}
